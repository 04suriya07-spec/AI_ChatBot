# AuraDesk AI Backend — Environment Variables
# Copy this to .env and fill in your real keys

# ─── SERVER ────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── TWILIO ────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1415xxxxxxx

# ─── DEEPGRAM (Real-time Speech-to-Text) ───────────────
# Get from: https://console.deepgram.com (free $200 credit)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ─── GOOGLE GEMINI (LLM Brain) ─────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─── ELEVENLABS (Ultra-Realistic TTS) ──────────────────
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Voice ID: Use "Rachel" or your cloned voice ID from ElevenLabs dashboard
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── SUPABASE (Database) ───────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ─── GOOGLE CALENDAR (Appointment Booking) ─────────────
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# After OAuth flow, paste the refresh token here:
GOOGLE_REFRESH_TOKEN=your_refresh_token

# ─── WEBHOOK PUBLIC URL ────────────────────────────────
# For local dev: run `ngrok http 4000` and paste the https URL here
# For production: your Railway/Render/Fly.io URL
PUBLIC_URL=https://your-ngrok-or-deploy-url.ngrok-free.app
